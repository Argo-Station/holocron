{
  "steps": [
    {
      "id": "minion",
      "label": "Minion Generator",
      "defaultView": "archetype-browser",
      "views": {
        "archetype-browser": {
          "layoutId": "content-nav",
          "widgets": {
            "list": {
              "type": "ArchetypeList",
              "slot": "content",
              "props": { "tier": "minion" }
            },
            "nav": {
              "type": "StepperNav",
              "slot": "nav",
              "props": {
                "actions": [
                  { "label": "‹ BACK", "action": "close" },
                  { "label": "CUSTOM BUILD ›", "action": "navigate", "target": "custom-builder" }
                ]
              }
            }
          }
        },
        "archetype-detail": {
          "layoutId": "content-nav",
