            "statblock": {
              "type": "NpcStatBlock",
              "slot": "content",
              "props": { "editable": true }
            },
            "nav": {
              "type": "StepperNav",
              "slot": "nav",
              "props": {
                "actions": [
                  { "label": "‹ BACK", "action": "navigate", "target": "archetype-browser" },
                  { "label": "SAVE NPC", "action": "confirm" }
