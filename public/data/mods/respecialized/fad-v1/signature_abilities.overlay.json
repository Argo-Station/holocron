    "unmatchedamb": {
      "id": "unmatchedamb",
      "_source_key": "UNMATCHEDAMB",
      "name": "Unmatched Ambition",
      "description": "Only one word can describe those who dedicate their lives to criminal pursuits: ambitious. If they aren't in a constant struggle to realize their own rags to riches story, they are working to multiply the multitudes of their wealth and influence. Be it by cold ruthlessness, an expression of skill, or through sheer force of will, a career Syndicate won't allow anything to stand between them and their goals.\n\nOnce per session as an incidental, before rolling a check with a base difficulty of Average ([DI][DI]) or easier check, spend 2 Destiny Points to treat that check as if it was succeeded with a single [SU].",
      "careers": [
        "syndicate"
      ],
      "attach": {
        "columns": [
          3,
          4
        ]
      },
