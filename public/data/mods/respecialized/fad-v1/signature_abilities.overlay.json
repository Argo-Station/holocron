    "unmatchedconnection": {
      "id": "unmatchedconnection",
      "_source_key": "UNMATCHEDCONNECTION",
      "name": "Unmatched Connection",
      "description": "Once per session as maneuver, the character may spend 2 Destiny Points, then choose a character who can be affected by the Force within medium range. Both the character and the chosen target upgrade the difficulty of all Coercion, Deception, Combat, as well as any other hostile or subversive checks made targeting the other once until the end of the next round. They both also upgrade the ability of all Charm, Negotiation, and Leadership checks as well as any other checks made to support or aid one another once until the end of the next round. Any [TR] results from checks whose ability was upgraded this way must mutually benefit the target and character, but any [DE] results from checks whose difficulty was upgraded this way may only negatively affect the character making the check.",
      "careers": [
        "consular"
      ],
      "attach": {
        "columns": [
          3,
          4
        ]
      },
      "abilities": {
        "unmatchedconba": {
          "name": "Unmatched Connection Base Ability",
          "description": "Once per session as maneuver, the character may spend 2 Destiny Points, then choose a character who can be affected by the Force within medium range. Both the character and the chosen target upgrade the difficulty of all Coercion, Deception, Combat, as well as any other hostile or subversive checks made targeting the other once until the end of the next round. They both also upgrade the ability of all Charm, Negotiation, and Leadership checks as well as any other checks made to support or aid one another once until the end of the next round. Any [TR] results from checks whose ability was upgraded this way must mutually benefit the target and character, but any [DE] results from checks whose difficulty was upgraded this way may only negatively affect the character making the check.",
          "told": [
            {
              "id": "told",
              "words": {
