{
  "signature_abilities": {
    "ciaf": {
      "id": "ciaf",
      "_source_key": "CIAF",
      "name": "Calling In A Favor",
      "description": "Calling in a Favor is a nod to the Colonist’s history, and the assumption that they have a storied past filled with characters worth engaging with. It leverages the Colonist’s contacts for some sort of mechanical and narrative benefit.\n\n Once per session, may spend 2 Destiny Points and make a Hard ([DI][DI][DI]) Charm check. If successful, the character establishes a contact who owes them a favor, and will provide otherwise unobtainable information to the character. This information must be immediately relevant to the character's current challenge, but sharing it must not put the contact in immediate danger. For the remainder of the session, the character may suffer 2 strain to add [SU] to a check directly related to the information provided by the favor.",
      "careers": [
        "colonist"
      ],
      "attach": {
        "columns": [
          1,
          2
        ]
      },
      "abilities": {
        "ciafbase": {
          "name": "Calling In A Favor Base Ability",
          "description": "Once per session, may spend 2 Destiny Points and make a Hard ([DI][DI][DI]) Charm check. If successful, the character establishes a contact who owes them a favor, and will provide otherwise unobtainable information to the character. This information must be immediately relevant to the character's current challenge, but sharing it must not put the contact in immediate danger. For the remainder of the session, the character may suffer 2 strain to add [SU] to a check directly related to the information provided by the favor.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 527,
                "hash": "f24175d355a0"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFBASE"
              }
            }
          ],
          "activation_check": {
            "difficulty": "Hard",
            "skill": "Charm"
          }
        },
        "ciafnegot": {
          "name": "Change Skill: Negotiation",
          "description": "When activating Calling In A Favor, the character may make a Negotiation check instead of a Charm check.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 104,
                "hash": "3e4f5094cb73"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFNEGOT"
              }
            }
          ]
        },
        "ciafffg": {
          "name": "Favor For Goods",
          "description": "The favor the character calls in may now come in the form of legal goods instead of information. The credit cost of the goods may not exceed 200 times the character’s Presence, and the rarity may not be higher than a number equal to the character’s Presence. The delivery or appearance of the equipment is up to GM discretion, but should directly aid the character in their current challenge. For the remainder of the session, the character may suffer 2 strain to add [SU] to a check to which the provided goods are relevant.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 525,
                "hash": "cb5ec88033e1"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFFFG"
              }
            }
          ]
        },
        "ciafrd": {
          "name": "Reduce Difficulty",
          "description": "Reduce the difficulty of the skill check to activate Calling In A Favor to Average ([DI][DI]).",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 94,
                "hash": "8529a7496c26"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFRD"
              }
            }
          ]
        },
        "ciafundstre": {
          "name": "Change Skill: Knowledge (Society) or Streetwise",
          "description": "When activating Calling In A Favor, the character may make a Knowledge (Society) or Streetwise check instead of a Charm check.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 126,
                "hash": "ce9a90b8b843"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFUNDSTRE"
              }
            }
          ]
        },
        "ciafsf": {
          "name": "Supreme Favor",
          "description": "The character may spend [AD][AD][AD] or [TR] from the check to activate Calling In A Favor to remove the restriction from the favor provided. If the favor is information, that information may put the contact in immediate peril, and be even more valuable or sought-after. If the favor is goods, the credit cost limit is doubled, and the rarity value limit is increased by 3, and the good may be restricted. If the favor is a service, the service may be illegal and/or incredibly dangerous.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 488,
                "hash": "757e921b046d"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFSF"
              }
            }
          ]
        },
        "ciafgf": {
          "name": "Greater Favor",
          "description": "After activating Calling In A Favor, the character may instead suffer 2 strain to add [SU][AD] to a check related to the favor.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 127,
                "hash": "c0d234118c7e"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFGF"
              }
            }
          ]
        },
        "ciafdestiny": {
          "name": "Destiny",
          "description": "Calling In A Favor costs 1 Destiny Point to activate instead of 2.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 66,
                "hash": "642acf6ad191"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFDESTINY"
              }
            }
          ]
        },
        "ciafffs": {
          "name": "Favor For Services",
          "description": "The favor the character calls in may now come in the form of legal services instead of information. The nature and scope of the service is up to the Game Master, but it should not be obviously suicidal or lead to immediate pursuit by authorities. The service should be able to be performed during this session, and should directly aid the character in their current challenge.  For the remainder of the session, the character may suffer 2 strain to add [SU] to a check to which the provided services are relevant.",
          "told": [
            {
              "id": "told",
              "words": {
                "start": 0,
                "end": 513,
                "hash": "149bc3b1c4a5"
              },
              "cite": {
                "unprinted": "pack",
                "from": "respecialized@eote-v2:CIAFFFS"
              }
            }
          ]
        }
      },
