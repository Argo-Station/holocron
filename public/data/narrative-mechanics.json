    "applyOrder": [
      "Compute baseValue from startingValueRule.",
      "Apply selected tradeOptions (validate once-per-option).",
      "For Obligation and Duty, enforce abs(totalValueDelta) <= baseValue.",
      "finalValue = baseValue + totalValueDelta.",
      "Apply xpDelta and creditsDelta to starting resources."
    ]
