{
  "steps": [
    {
      "id": "minion",
      "label": "Minion Group",
      "defaultView": "minion-identity",
      "views": {
        "minion-identity": {
          "layoutId": "content-nav",
          "widgets": {
            "faction": { "type": "FactionSelector", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 BACK", "action": "close" },
              { "label": "INTEL \u203a", "action": "navigate", "target": "faction-reveal" }
            ]}}
          }
        },
        "faction-reveal": {
          "layoutId": "content-nav",
          "widgets": {
            "reveal": { "type": "FactionRevealPanel", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 BACK", "action": "navigate", "target": "minion-identity" },
              { "label": "CONTINUE \u203a", "action": "navigate", "target": "key-figures" }
            ]}}
          }
        },
        "key-figures": {
          "layoutId": "content-nav",
          "widgets": {
            "figures": { "type": "KeyFiguresPanel", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 INTEL", "action": "navigate", "target": "faction-reveal" },
              { "label": "CONTINUE \u203a", "action": "navigate", "target": "minion-archetype" }
            ]}}
          }
        },
        "figure-reveal": {
          "layoutId": "content-nav",
          "widgets": {
            "reveal": { "type": "FigureRevealCard", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 FIGURES", "action": "navigate", "target": "key-figures" },
              { "label": "REFERENCE \u203a", "action": "navigate", "target": "figure-reference" }
            ]}}
          }
        },
        "figure-reference": {
          "layoutId": "content-nav",
          "widgets": {
            "reference": { "type": "FigureReferenceCard", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 DOSSIER", "action": "navigate", "target": "figure-reveal" },
              { "label": "CONTINUE \u203a", "action": "navigate", "target": "minion-archetype" }
            ]}}
          }
        },
        "minion-archetype": {
          "layoutId": "content-nav",
          "widgets": {
            "header": { "type": "MinionFieldContactHeader", "slot": "content", "props": {} },
            "groupsize": { "type": "MinionGroupSizeSelector", "slot": "content", "props": {} },
            "archetypes": { "type": "MinionArchetypeBrowser", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 FIGURES", "action": "navigate", "target": "key-figures" },
              { "label": "REFERENCE \u203a", "action": "navigate", "target": "minion-reference" }
            ]}}
          }
        },
        "minion-reference": {
          "layoutId": "content-nav",
          "widgets": {
            "reference": { "type": "MinionReferenceCard", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 GROUP", "action": "navigate", "target": "minion-archetype" },
              { "label": "SAVE \u2713", "action": "confirm" }
            ]}}
          }
        },
        "custom-minion": {
          "layoutId": "content-nav",
          "widgets": {
            "builder": { "type": "CustomMinionBuilder", "slot": "content", "props": {} },
            "nav": { "type": "StepperNav", "slot": "nav", "props": { "actions": [
              { "label": "\u2039 BACK", "action": "navigate", "target": "minion-archetype" }
            ]}}
          }
        }
